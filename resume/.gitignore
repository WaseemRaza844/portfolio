.venv/
__pycache__/
# Editable .tex files and final .pdf files are committed beside profile JSON.
# Only TeX compiler intermediates and extracted text are ignored.
resume-profiles/**/*.txt
resume-profiles/**/*.aux
resume-profiles/**/*.log
resume-profiles/**/*.out
resume-profiles/**/*.toc
resume-profiles/**/*.synctex.gz

job-applications/**/*.aux
job-applications/**/*.log
job-applications/**/*.out
job-applications/**/*.toc
job-applications/**/*.synctex.gz
job-applications/faculty/**/*.txt
